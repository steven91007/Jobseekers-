# 複製這個檔案成 .env 後填入實際值。.env 已被 .gitignore 排除，絕不要 commit。

# --- 必填 ---
# Discord Developer Portal -> Applications -> 你的 App -> Bot -> Reset Token
DISCORD_TOKEN=

# --- 選填 ---
# 開發用伺服器 ID。填了的話 slash 指令會即時同步到該伺服器（方便測試）；
# 留空則同步為全域指令，最多需要 1 小時才會出現。
DISCORD_DEV_GUILD_ID=

# 收警報 DM 的使用者 ID。留空則不發 DM，只寫 log 與更新 presence。
JOBBOT_OWNER_ID=

# 每天推播時間（24 小時制 HH:MM，台北時間）
JOBBOT_PUSH_TIME=09:00

JOBBOT_TZ=Asia/Taipei
JOBBOT_DB=data/jobs.db
JOBBOT_LOG_DIR=logs

# 每個訂閱單次推播最多幾筆新職缺（超出的仍會標記為已看過，避免每天重新排隊）
JOBBOT_MAX_NEW_PER_PUSH=10

# 訂閱之間的間隔秒數下限／上限（會在區間內取隨機值，避免固定節奏被判定為機器人）
JOBBOT_GAP_MIN=8
JOBBOT_GAP_MAX=20

# 單次爬取的內部 deadline（秒）。必須小於 JOBBOT_SCRAPE_TIMEOUT。
JOBBOT_SCRAPE_DEADLINE=120
JOBBOT_SCRAPE_TIMEOUT=180

# 已推播職缺的保留天數。不要低於 60 —— LinkedIn 會讓舊職缺重新浮上來，
# 保留太短會造成重複推播。
JOBBOT_SEEN_RETENTION_DAYS=90

LOG_LEVEL=INFO

# --- gitkb（git 歷史知識庫，選填）---
# 筆記與索引存放目錄（相對於 repo 根目錄）
GITKB_KNOWLEDGE_DIR=knowledge
# 單一檔案 diff 超過此位元組數會被截斷；整個 commit 超過 total 會把後面的檔案縮成只留標頭
GITKB_PER_FILE_CAP_BYTES=65536
GITKB_TOTAL_CAP_BYTES=400000
# 不摘要內容的路徑（逗號分隔 glob）。knowledge/** 必須保留，否則筆記本身會被再摘要一次
GITKB_EXCLUDE_GLOBS=knowledge/**

# --- 簽證支持檢查（選填）---
# 規則判斷不需要任何金鑰。填了 ANTHROPIC_API_KEY 之後，規則判不出來的職缺會交給 Claude 輔助判斷；
# 留空則那些職缺維持「不明」。VISA_LLM_ASSIST=0 可在有金鑰時仍關閉 LLM 輔助。
ANTHROPIC_API_KEY=
VISA_LLM_ASSIST=1
VISA_LLM_MODEL=claude-opus-5

# =====================================================================
# jobagent (python -m jobagent): AI job agent for Germany / Netherlands / Dublin
# Everything below is optional. With no keys at all, `run` still collects,
# dedupes and reports; scoring and the research agent need OPENAI_API_KEY,
# and tracing needs the two Langfuse keys.
# =====================================================================

# --- OpenAI (scoring + research agent) ---
OPENAI_API_KEY=
# Model for the research agent. Check that your key can use it: python -m jobagent doctor
OPENAI_MODEL=gpt-5
# Model for per-job scoring (defaults to OPENAI_MODEL). A cheaper model is fine here.
OPENAI_SCORER_MODEL=
# Reasoning effort (minimal/low/medium/high). Leave empty for non-reasoning models.
JOBAGENT_AGENT_REASONING=medium
JOBAGENT_SCORER_REASONING=low
# 0 turns off OpenAI's built-in web_search tool for the agent
JOBAGENT_AGENT_WEB_SEARCH=1

# --- Langfuse (observability) ---
# Keys from your Langfuse project: Settings -> API Keys. EU cloud shown; US is
# https://us.cloud.langfuse.com, or your self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# user_id attached to traces
JOBAGENT_USER_ID=me
# production | development. Use development while experimenting.
JOBAGENT_ENV=production
# 1 = redact emails, +country phone numbers and API keys before export; 0 = off
JOBAGENT_LANGFUSE_MASK=1

# --- jobagent knobs ---
JOBAGENT_DB=data/jobagent.db
JOBAGENT_REPORTS_DIR=reports
# Your candidate profile. Relative paths are resolved against the repo; an absolute path
# lets worktrees and other checkouts share one profile. Scoring refuses to run when the
# file is missing or is still the unedited profile.example.md template.
JOBAGENT_PROFILE=profile.md
# Jobs scored per run (AI Engineer titles first, then newest). Unscored ones are scored on later runs.
JOBAGENT_MAX_SCORE_PER_RUN=40
JOBAGENT_AGENT_MAX_TURNS=12
# LinkedIn results per (region x query) search, and the pause between searches (seconds)
JOBAGENT_LINKEDIN_PER_QUERY=25
# Same, for --since 24h (the default): deep enough to list every posting in the window
JOBAGENT_LINKEDIN_PER_QUERY_24H=100
JOBAGENT_LINKEDIN_GAP_MIN=2
JOBAGENT_LINKEDIN_GAP_MAX=5
JOBAGENT_SCRAPE_DEADLINE=90
JOBAGENT_ATS_WORKERS=8
# Recency: nothing older than this many days is listed or scored
JOBAGENT_MAX_AGE_DAYS=7
# Freshness score halves every N hours; its weight in the rank (rest is the LLM fit score)
JOBAGENT_FRESHNESS_HALF_LIFE_HOURS=24
JOBAGENT_FRESHNESS_WEIGHT=0.3
# 1 = list only postings written in English that do not require German or Dutch (default).
# 0 = keep every language. One run can override with `run --all-languages`.
JOBAGENT_ENGLISH_ONLY=1

# --- MCP server（python -m mcp_server，選填）---
# 追蹤沿用上面 Langfuse 區塊的 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_BASE_URL
# 與 JOBAGENT_USER_ID；沒填金鑰則 MCP server 照常運作、不追蹤。
# production | development：測試時設 development，避免污染正式的 dashboard
LANGFUSE_TRACING_ENVIRONMENT=production
# 設 0 可關閉 email／電話／金鑰遮罩（預設開啟，職缺描述常含招募者聯絡方式）
MCP_LANGFUSE_MASK=1
# 兩次 LinkedIn 工具呼叫之間的最小間隔秒數（agent 呼叫得比人快很多）
MCP_LINKEDIN_MIN_GAP=3
